{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  // How often one connection may ask Momo for a reply, her voice, and the
  // paper she writes after each reply.
  // Out of reach by hand (people on one office network share it); it is
  // there to stop a machine sending hundreds, so the shared keys last.
  "ratelimits": [
    { "name": "MOMO_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "VOICE_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
